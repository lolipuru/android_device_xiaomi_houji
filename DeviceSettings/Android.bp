android_app {
    name: "DeviceSettings",
    certificate: "platform",
    srcs: ["src/**/*.kt"],
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    static_libs: [
        "androidx.core_core",
        "androidx.preference_preference",
        "SettingsLib",
        "qcrilhook",
    ],
    required: [
        "privapp_whitelist_xiaomi.settings.xml",
    ],
}

prebuilt_etc {
    name: "privapp_whitelist_xiaomi.settings.xml",
    src: "permissions/privapp_whitelist_com.xiaomi.settings.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}